# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetingwise
DB_USER=meetingwise
DB_PASSWORD=meetingwise

# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model selection (overrides defaults)
CHAT_MODEL=nemotron-3.5-lightning-30b-a3
EMBEDDING_MODEL=nemotron-3.5-embed-1b

# Chat behavior
CHAT_RETRIEVAL_TOP_K=6
CHAT_MIN_SIMILARITY=0.20
